{
  "expo": {
    "name": "wanderable",
    "slug": "wanderable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wanderable-icon.png",
    "scheme": "wanderable",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.khoilikereact.wanderable",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow Wanderable to use your location so the trip map can open from where you are right now."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/wanderable-icon.png",
        "monochromeImage": "./assets/images/wanderable-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.khoilikereact.wanderable"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/wanderable-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wanderable-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wanderable to open your photo library so you can add trip photos to a highlight."
        }
      ],
      [
        "expo-media-library",
        {
          "isAccessMediaLocationEnabled": true,
          "mediaLibraryPermission": "Allow Wanderable to access your media library so you can add trip photos to a highlight."
        }
      ],
      "expo-location",
      "expo-sqlite",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ac37462-e5a9-45cc-869f-4501a60d3c61"
      }
    }
  }
}
